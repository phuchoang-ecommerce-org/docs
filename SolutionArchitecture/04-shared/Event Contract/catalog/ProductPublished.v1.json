{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecp.phuchoang.org/event-contracts/catalog/ProductPublished.v1.json",
  "allOf": [
    {
      "$ref": "../envelope.v1.json"
    },
    {
      "properties": {
        "eventType": {
          "const": "ProductPublished"
        },
        "eventVersion": {
          "const": 1
        },
        "aggregateType": {
          "const": "Product"
        },
        "payload": {
          "type": "object",
          "required": [
            "productId",
            "variantSkus",
            "affectedCategorySlugs"
          ],
          "properties": {
            "productId": {
              "type": "string",
              "format": "uuid"
            },
            "variantSkus": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "affectedCategorySlugs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "variantIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "affectedCategoryIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
