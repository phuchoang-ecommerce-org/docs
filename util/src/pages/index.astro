---
import BaseLayout from '../layouts/BaseLayout.astro';
import FolderTree from '../components/FolderTree.astro';
import { buildFolderTree, countDocuments, getDocuments } from '../lib/docs';

const documents = await getDocuments();
const tree = buildFolderTree(documents);
const highlightedPaths = ['README.md', 'BA-docs/README.md', 'SA-docs/README.md', 'PM-docs/README.md', 'SA-docs/01-system/Solution Architecture.md'];
const highlighted = highlightedPaths.flatMap((path) => documents.filter((document) => document.path === path));
---

<BaseLayout title="ECP / documentation utility">
  <div class="mx-auto min-h-screen max-w-[92rem] px-5 py-5 sm:px-8 sm:py-8 lg:px-12">
    <header class="flex items-center justify-between border-b border-line pb-5" aria-label="Utility header">
      <a href="/" class="group inline-flex items-center gap-3 text-sm font-semibold tracking-[0.18em] text-ink uppercase">
        <span class="grid size-8 place-items-center rounded-full border border-moss text-[0.68rem] text-moss transition-colors group-hover:bg-moss group-hover:text-paper">E</span>
        ECP / util
      </a>
      <p class="hidden text-sm text-stone sm:block">Documentation, without the noise.</p>
    </header>

    <main id="main" class="grid gap-14 py-14 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20 lg:py-20">
      <div>
        <p class="mb-5 text-xs font-semibold tracking-[0.2em] text-moss uppercase">Documentation workspace</p>
        <h1 class="max-w-3xl font-serif text-5xl leading-[1.02] tracking-[-0.035em] text-ink sm:text-6xl lg:text-7xl">Everything important. Nothing competing for attention.</h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-stone">A quiet index for the Enterprise Commerce Platform: strategy, architecture, and delivery decisions in one deliberate reading space.</p>

        <div class="mt-10 flex flex-wrap gap-3" aria-label="Documentation actions">
          <a href="#library" class="rounded-sm bg-moss px-5 py-3 text-sm font-semibold text-paper transition-colors hover:bg-ink">Browse the library</a>
          <a href="https://github.com/phuchoang-ecommerce-org/docs" class="rounded-sm border border-line px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-moss hover:bg-sage">View repository <span aria-hidden="true">↗</span></a>
        </div>

        <section class="mt-20" aria-labelledby="continue-reading">
          <div class="flex items-baseline justify-between border-b border-line pb-3">
            <h2 id="continue-reading" class="font-serif text-2xl tracking-[-0.02em]">Start with the spine</h2>
            <span class="text-xs font-semibold tracking-[0.14em] text-stone uppercase">{documents.length} documents</span>
          </div>
          <div class="divide-y divide-line">
            {highlighted.map((document, index) => (
              <a href={`/${document.path}`} class="group grid gap-3 py-5 sm:grid-cols-[2rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-5">
                <span class="font-serif text-lg text-moss">0{index + 1}</span>
                <span>
                  <span class="block text-base font-semibold text-ink group-hover:text-moss">{document.title}</span>
                  <span class="mt-1 block max-w-2xl text-sm leading-6 text-stone">{document.summary}</span>
                </span>
                <span class="text-sm text-stone group-hover:text-moss" aria-hidden="true">Read →</span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:pt-1">
        <div class="border-l border-line pl-5">
          <p class="text-xs font-semibold tracking-[0.16em] text-stone uppercase">This workspace</p>
          <p class="mt-3 font-serif text-2xl leading-tight">Stay in the document. Keep your place.</p>
          <p class="mt-3 text-sm leading-6 text-stone">The structure is intentionally spare: a direct path to the material and room to think through it.</p>
        </div>
        <dl class="mt-9 grid grid-cols-3 gap-3 lg:grid-cols-1 lg:gap-0">
          {tree.children.filter((node) => node.children.length > 0).map((node) => (
            <div class="border-t border-line py-3 lg:flex lg:items-baseline lg:justify-between">
              <dt class="text-sm capitalize text-stone">{node.name.replace(/-docs$/, '').replaceAll('-', ' ')}</dt>
              <dd class="font-serif text-xl text-moss">{countDocuments(node)}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </main>

    <section id="library" class="border-t border-line py-14 lg:py-20" aria-labelledby="library-title">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-moss uppercase">Library</p>
          <h2 id="library-title" class="mt-3 font-serif text-4xl tracking-[-0.03em]">Browse the repository</h2>
        </div>
        <label class="relative block sm:w-80">
          <span class="sr-only">Filter documentation</span>
          <input id="doc-filter" type="search" placeholder="Filter by title or path" class="w-full rounded-none border-b border-line bg-transparent px-0 py-3 text-base text-ink placeholder:text-stone focus:border-moss focus:outline-none" />
        </label>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20">
        <nav aria-label="Documentation folders" class="min-w-0">
          <ul class="space-y-1">
            <FolderTree node={tree} />
          </ul>
        </nav>
        <aside class="border-l border-line pl-5 text-sm leading-6 text-stone">
          <p class="font-serif text-xl leading-tight text-ink">A filesystem, not a feed.</p>
          <p class="mt-3">Expand only the branch you need. Folder counts stay visible so the shape of the material is clear before you open it.</p>
          <p id="filter-status" class="mt-6 text-xs font-semibold tracking-[0.12em] text-moss uppercase" aria-live="polite"></p>
        </aside>
      </div>
      <p id="empty-state" class="mt-12 hidden border-l-2 border-moss pl-4 text-sm leading-6 text-stone">No documents match that filter. Try a broader term.</p>
    </section>

    <footer class="border-t border-line py-7 text-xs leading-5 text-stone">
      Source-first documentation for the Enterprise Commerce Platform.
    </footer>
  </div>

  <script>
    const filter = document.querySelector<HTMLInputElement>('#doc-filter');
    const documents = Array.from(document.querySelectorAll<HTMLElement>('[data-document]'));
    const folders = Array.from(document.querySelectorAll<HTMLElement>('[data-folder]'));
    const emptyState = document.querySelector<HTMLElement>('#empty-state');
    const status = document.querySelector<HTMLElement>('#filter-status');

    filter?.addEventListener('input', () => {
      const query = filter.value.trim().toLowerCase();
      let matches = 0;
      documents.forEach((document) => {
        const visible = !query || document.dataset.search?.includes(query);
        document.hidden = !visible;
        if (visible) matches += 1;
      });
      folders.forEach((folder) => {
        const hasVisibleDocument = Array.from(folder.querySelectorAll<HTMLElement>('[data-document]')).some((document) => !document.hidden);
        folder.hidden = !hasVisibleDocument;
        const disclosure = folder.querySelector('details');
        if (query && disclosure) disclosure.open = true;
      });
      if (emptyState) emptyState.hidden = matches !== 0;
      if (status) status.textContent = query ? `${matches} matching ${matches === 1 ? 'document' : 'documents'}` : '';
    });
  </script>
</BaseLayout>
