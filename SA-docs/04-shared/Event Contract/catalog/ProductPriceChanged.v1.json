{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecp.phuchoang.org/event-contracts/catalog/ProductPriceChanged.v1.json",
  "allOf": [
    {"$ref": "../envelope.v1.json"},
    {
      "properties": {
        "eventType": {"const": "ProductPriceChanged"},
        "eventVersion": {"const": 1},
        "aggregateType": {"const": "Product"},
        "payload": {
          "type": "object",
          "required": ["productId", "variantSkus"],
          "properties": {
            "productId": {"type": "string", "format": "uuid"},
            "variantSkus": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
