{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecp.phuchoang.org/event-contracts/envelope.v1.json",
  "title": "ECP event envelope v1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateType", "aggregateId", "correlationId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "minLength": 1},
    "eventVersion": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "aggregateType": {"type": "string", "minLength": 1},
    "aggregateId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": "string", "format": "uuid"},
    "actor": {"type": ["object", "null"], "properties": {"userId": {"type": "string", "format": "uuid"}, "role": {"type": ["string", "null"]}}, "additionalProperties": false},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
